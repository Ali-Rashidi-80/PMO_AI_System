    {
      "parameters": {
        "jsCode": "try {\n  const inputItem = $input.item?.json || {};\n  \n  if (inputItem.error) {\n     return [{ json: { htmlReport: '<h2>خطا در سرور AI</h2><p>پردازش مدل با خطا مواجه شد.</p>' } }];\n  }\n\n  let rawOutput = String(inputItem.output || '');\n  rawOutput = rawOutput.replace(/<\\|think\\|>[\\s\\S]*?<\\/\\|think\\|>\\s*/gi, '');\n  \n  if (rawOutput.trim() === '') {\n      rawOutput = 'موردی برای گزارش یافت نشد (خروجی خالی از مدل).';\n  }\n\n  const executionDate = new Date().toLocaleDateString('fa-IR');\n  \n  let formattedHtml = rawOutput\n      .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\n      .replace(/\\*(.*?)\\*/g, '<em>$1</em>')\n      .replace(/\\n\\s*-\\s+(.*)/g, '<li>$1</li>')\n      .replace(/\\n/g, '<br/>');\n\n  if (formattedHtml.includes('<li>')) {\n      formattedHtml = formattedHtml.replace(/<li>/g, '<ul><li>').replace(/<\\/li><br\\/>/g, '</li></ul>');\n  }\n\n  const dashboardHtml = `\n  <!DOCTYPE html>\n  <html lang=\"fa\" dir=\"rtl\">\n  <head>\n      <meta charset=\"UTF-8\">\n      <style>\n          body { font-family: Tahoma, sans-serif; background: #f4f7f6; color: #333; padding: 20px; }\n          .container { max-width: 800px; margin: auto; background: #fff; padding: 30px; border-radius: 8px; border-top: 5px solid #1a365d; }\n          .header { text-align: center; margin-bottom: 20px; }\n          .alert { background: #fff3cd; color: #856404; padding: 15px; border-right: 4px solid #ffeeba; }\n      </style>\n  </head>\n  <body>\n      <div class=\"container\">\n          <div class=\"header\">\n              <h2>گزارش ریسک هوش مصنوعی (PMO)</h2>\n              <small>تاریخ استخراج: ${executionDate}</small>\n          </div>\n          <div class=\"alert\">\n              ${formattedHtml}\n          </div>\n      </div>\n  </body>\n  </html>`;\n\n  return [{ json: { htmlReport: dashboardHtml } }];\n} catch (e) {\n  return [{ json: { htmlReport: `<h2>خطای سیستمی</h2><p>${e.message}</p>` } }];\n}"
      },
