    {
      "parameters": {
        "jsCode": "try {\n  let rawText = $input.item?.json?.text || '';\n  if (!rawText.trim() || rawText.length < 10) {\n    return [{ json: { isValid: false, text: '' } }];\n  }\n  // حفظ فاصله‌ها و حذف کاراکترهای نامرئی که دیتابیس را به هم می‌ریزند\n  let cleanText = rawText.replace(/\\u0000/g, '').replace(/[^\\x20-\\x7E\\u0600-\\u06FF\\s\\n\\r\\t]/g, '').trim();\n  return [{ json: { isValid: true, text: cleanText } }];\n} catch (e) {\n  return [{ json: { isValid: false, text: '' } }];\n}"
      },
