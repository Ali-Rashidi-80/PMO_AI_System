    {
      "parameters": {
        "jsCode": "try {\n  if ($input.item?.json?.error) {\n    return [{ json: { status: 'failed', message: 'خطا در ارتباط با موتور پردازشی لوکال' } }];\n  }\n\n  let outputText = String($input.item?.json?.output || '');\n  \n  if (outputText.includes('ERROR_NO_DOCS') || outputText.trim() === '') {\n    return [{ json: { status: 'failed', message: 'هیچ سند حقوقی یافت نشد. پردازش جهت جلوگیری از توهم متوقف گردید.' } }];\n  }\n  \n  // فیلتر تگ‌های دیپ‌سیک/جما/کیوون\n  let cleanLetter = outputText.replace(/<\\|think\\|>[\\s\\S]*?<\\/\\|think\\|>\\s*/gi, '').trim();\n  \n  // تضمین بازگشت Array\n  return [{ json: { status: 'success', letter: cleanLetter } }];\n} catch(e) {\n  return [{ json: { status: 'failed', message: 'خطای سیستمی', details: e.message } }];\n}"
      },
